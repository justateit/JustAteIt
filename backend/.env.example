# Copy to backend/.env and fill in real values. Never commit backend/.env.

# ── Database (user_service, catalog_service) ─────────────────────────────
# PostgreSQL connection string, e.g. RDS or a local instance.
DATABASE_URL=postgresql://username:password@host:5432/justateit

# ── Google Places (catalog_service venue lookup) ─────────────────────────
GOOGLE_API_KEY=your-google-places-api-key

# ── S3 (media_service) ────────────────────────────────────────────────────
# Required for uploads. The service fails with a clear error if unset.
S3_BUCKET=your-media-bucket
S3_REGION=us-east-1

# Optional: custom S3 endpoint for local development (LocalStack, MinIO).
# Leave unset to use the real AWS S3 endpoint.
#S3_ENDPOINT_URL=http://localhost:4566

# Optional: public base URL for returned media URLs (e.g. CloudFront).
# Leave unset to return standard https://<bucket>.s3.<region>.amazonaws.com URLs.
#S3_PUBLIC_BASE_URL=https://media.example.com

# ── AWS credentials ───────────────────────────────────────────────────────
# Do NOT set static AWS keys here. The media service uses boto3's default
# credential chain: on ECS/Fargate the task role is picked up automatically;
# locally use `aws configure`, AWS_PROFILE, or SSO.
#AWS_PROFILE=your-local-profile

# ── Service URLs (only needed outside docker-compose) ─────────────────────
# docker-compose sets these to the in-network hostnames automatically.
#USER_SERVICE_URL=http://localhost:8001
#CATALOG_SERVICE_URL=http://localhost:8002
#MEDIA_SERVICE_URL=http://localhost:8003
